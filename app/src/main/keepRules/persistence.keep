# Persisted JSON predates R8: preserve field names and reflective constructors.
-keep class com.example.lovale2.data.settings.OfferRecord { *; }
-keep class com.example.lovale2.domain.CostEstimate { *; }
-keep class com.example.lovale2.domain.VehicleCosts { *; }
-keep class com.example.lovale2.domain.AutoFuelSettings { *; }

-keep class com.example.lovale2.domain.DriverOptions { *; }
-keep class com.example.lovale2.domain.TimeRule { *; }
-keep class com.example.lovale2.domain.ConfigurationBackup { *; }

# These dependencies instantiate implementations by reflection. Keep explicit constructors:
# class-only rules in older consumer configurations do not preserve them in full mode.
-keep class * extends androidx.room.RoomDatabase {
    public <init>();
}
-keep class * implements com.google.firebase.components.ComponentRegistrar {
    public <init>();
}
-keep class * extends androidx.work.ListenableWorker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}
-keep class * implements com.google.android.datatransport.runtime.backends.BackendFactory {
    public <init>();
}
